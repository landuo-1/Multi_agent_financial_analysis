# LLM Configuration
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=sk-your-api-key-here

# Lightweight LLM (for simple tasks like entity extraction)
LLM_LIGHT_MODEL=gpt-4o-mini

# Embedding Model
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_API_KEY=sk-your-api-key-here

# Data Source
DATA_SOURCE_PRIORITY=baostock,akshare

# Cache
CACHE_DIR=./data/cache
SQLITE_DB_PATH=./data/cache/financial_cache.db

# Vector Store
CHROMA_PERSIST_DIR=./data/chroma

# LangSmith (optional)
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=financial-multi-agent

# Report Output
REPORT_OUTPUT_DIR=./reports

# Logging
LOG_LEVEL=INFO
